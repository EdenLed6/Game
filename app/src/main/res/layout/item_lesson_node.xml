<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nodeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackgroundBorderless">

    <!-- Top connector line -->
    <View
        android:id="@+id/vConnectorTop"
        android:layout_width="3dp"
        android:layout_height="20dp"
        android:background="@color/cardStroke"
        android:visibility="gone"/>

    <!-- Node container -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Inner circle -->
        <FrameLayout
            android:id="@+id/flNodeCircle"
            android:layout_width="88dp"
            android:layout_height="88dp">

            <!-- Emoji label -->
            <TextView
                android:id="@+id/tvNodeEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="36sp"
                android:layout_gravity="center"/>

            <!-- Overlay badge icon -->
            <ImageView
                android:id="@+id/ivNodeIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                android:contentDescription="@null"/>

        </FrameLayout>

    </FrameLayout>

    <!-- Label area below circle -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvNodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvNodeNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/onSurfaceMuted"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Bottom connector line -->
    <View
        android:id="@+id/vConnectorBottom"
        android:layout_width="3dp"
        android:layout_height="20dp"
        android:background="@color/cardStroke"/>

</LinearLayout>
