<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Gradient gamified header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_hero"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:background="@color/transparent"
            app:title="אתגר נינג׳ה"
            app:navigationIconTint="#FFFFFF"
            app:titleTextColor="#FFFFFF" />

        <!-- Stats row: Score | Lives | Streak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- High score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stats_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvChallengeHighScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Current score / streak / lives -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:background="@drawable/bg_stats_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tvChallengeStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            app:indicatorColor="#F59E0B"
            app:trackColor="#4A1A16"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tvChallengeCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:alpha="0.75"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Game card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutChallengeGame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/cardStroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Question prompt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvChallengePrompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:minLines="2"
                    android:textColor="@color/onSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Audio button for challenge question -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeakChallenge"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="2dp"
                    app:icon="@drawable/ic_volume"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    app:iconPadding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:backgroundTint="@color/surface" />

            </LinearLayout>

            <!-- Answer options -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChallengeOption0"
                style="@style/App.Button.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="54dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChallengeOption1"
                style="@style/App.Button.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="54dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChallengeOption2"
                style="@style/App.Button.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="54dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChallengeOption3"
                style="@style/App.Button.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp" />

            <TextView
                android:id="@+id/tvChallengeFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:minLines="2"
                android:textColor="@color/onSurfaceMuted"
                android:textSize="14sp"
                android:visibility="invisible" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Result screen -->
    <LinearLayout
        android:id="@+id/layoutChallengeResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@color/background"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvChallengeResultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="@color/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChallengeFinalScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:textColor="@color/onSurface"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChallengeResultMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:textColor="@color/onSurfaceMuted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnChallengeReplay"
            style="@style/App.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🔄  שחק שוב" />

        <Button
            android:id="@+id/btnChallengeBack"
            style="@style/App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="חזור למסך הראשי" />

    </LinearLayout>

</LinearLayout>
